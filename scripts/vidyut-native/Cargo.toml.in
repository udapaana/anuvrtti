# Template: scripts/build-vidyut-native.sh fills @VIDYUT@ with the vidyut
# checkout at VIDYUT_REV, so this CLI links exactly the engine CI pins.
[package]
name = "anuvrtti-cheda"
version = "0.1.0"
edition = "2021"

[workspace]

[dependencies]
vidyut-cheda = { path = "@VIDYUT@/vidyut-cheda" }
vidyut-kosha = { path = "@VIDYUT@/vidyut-kosha" }
vidyut-prakriya = { path = "@VIDYUT@/vidyut-prakriya" }
vidyut-lipi = { path = "@VIDYUT@/vidyut-lipi" }
serde_json = "1"

[profile.release]
debug = false
