[
  {"ocr_line":858,"section":"1.2.35+1","text":"स यथाकथितं पूर्वं नारदेन महर्षिणा / रघुवंशस्य चरितं चकार भगवानृषिः","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/858.jpg"},
  {"ocr_line":1044,"section":"1.14.6+2","text":"भयं त्यजत भद्रं वो हितार्थं युधि रावणम्","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/1044.jpg"},
  {"ocr_line":1048,"section":"1.14.6+3","text":"वत्स्यामि मानुषे लोके पालयन् पृथिवीमिमाम्","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/1048.jpg"},
  {"ocr_line":1062,"section":"1.14.6+4","text":"एवं दत्त्वा वरं देवो देवानां विष्णुरात्मवान् / मानुष्ये चिन्तयामास जन्मभूमिमथात्मनः","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/1062.jpg"},
  {"ocr_line":1202,"section":"1.17.1+1","text":"ततश्च द्वादशे मासे चैत्रे नावमिके तिथौ / नक्षत्रेऽदितिदैवत्ये स्वोच्चसंस्थेषु पञ्चसु","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/1202.jpg"},
  {"ocr_line":1240,"section":"1.17.9+1","text":"पुष्ये जातस्तु भरतो मीनलग्ने प्रसन्नधीः / सार्पे जातौ च सौमित्री कुलीरेऽभ्युदिते रवौ","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/1240.jpg"},
  {"ocr_line":1578,"section":"1.20.11+1","text":"तेषां निग्रहणे शक्तः स्वयं च कुशिकात्मजः / तव पुत्रहितार्थाय त्वामुपेत्याभियाचते","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/1578.jpg"},
  {"ocr_line":1780,"section":"1.24.13+1","text":"पातकं वा सदोषं वा कर्तव्यं रक्षता सदा","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/1780.jpg"},
  {"ocr_line":1836,"section":"1.25.8+2","text":"अभिदुद्राव काकुत्स्थं लक्ष्मणं च विनेदुषी","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/1836.jpg"},
  {"ocr_line":1855,"section":"1.25.21+1","text":"प्रविशन्नाश्रमपदं व्यरोचत महामुनिः","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/1855.jpg"},
  {"ocr_line":2230,"section":"1.71.10+1","text":"समक्षमग्नेः संस्थाप्य राघवाभिमुखे तदा","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/2230.jpg"},
  {"ocr_line":2246,"section":"1.72.17+1","text":"पतिव्रता महाभागा छायेवानुगता सदा","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/2246.jpg"},
  {"ocr_line":2247,"section":"1.72.17+2","text":"इत्युक्त्वा प्राक्षिपद्राजा मन्त्रपूतं जलं तदा","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/2247.jpg"},
  {"ocr_line":2259,"section":"1.72.17+3","text":"साधु साध्विति देवानामृषीणां वदतां तदा / देवदुन्दुभिनिर्घोषः पुष्पवर्षो महानभूत्","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/2259.jpg"},
  {"ocr_line":2270,"section":"1.72.17+4","text":"अब्रवीज्जनको राजा हर्षेणाभिपरिप्लुतः","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/2270.jpg"},
  {"ocr_line":2368,"section":"1.73.16+1","text":"भार्गवं जामदग्न्यं तं राजवंशविमर्दनम्","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/2368.jpg"},
  {"ocr_line":2498,"section":"1.75.21+1","text":"पुनर्जातं तदा मेने पुत्रमात्मानमेव च","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/2498.jpg"},
  {"ocr_line":2516,"section":"1.75.21+2","text":"कुमाराश्च महात्मानो वीर्येणाप्रतिमा भुवि","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/2516.jpg"},
  {"ocr_line":2571,"section":"1.76.17+1","text":"शत्रुघ्नो नित्यशत्रुघ्नो नीतः प्रीतिपुरस्कृतः","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/2571.jpg"},
  {"ocr_line":2697,"section":"2.2.15+1","text":"इच्छामो हि महाबाहुं रघुवीरं महाबलम् / गजेन महता यान्तं रामं छत्रावृताननम्","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/2697.jpg"},
  {"ocr_line":2941,"section":"2.7.1+1","text":"प्रहृष्टमुदितैः पौरैरुच्छ्रितध्वजमालिनीम् / अयोध्यां मन्थरा दृष्ट्वा परं विस्मयमागता","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/2941.jpg"},
  {"ocr_line":3057,"section":"2.7.29+1","text":"यथा मे भरतो मान्यस्तथा भूयोऽपि राघवः","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/3057.jpg"},
  {"ocr_line":3188,"section":"2.9.23+1","text":"चतुर्दश हि वर्षाणि रामे प्रव्राजिते वनम् / रूढश्च कृतमूलश्च शेषं स्थास्यति ते सुतः","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/3188.jpg"},
  {"ocr_line":3206,"section":"2.10.1+1","text":"पाण्डराभ्रमिवाकाशं राहुयुक्तं निशाकरः","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/3206.jpg"},
  {"ocr_line":3247,"section":"2.10.19+1","text":"यं मुहूर्तमपश्यंस्तु न जीवेयमहं ध्रुवम् / तेन रामेण कैकेयि शपे ते वचनक्रियाम्","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/3247.jpg"},
  {"ocr_line":3271,"section":"2.10.20+1","text":"स्मर राजन् पुरा वृत्तं तस्मिन् दैवासुरे रणे","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/3271.jpg"},
  {"ocr_line":3361,"section":"2.10.39+1","text":"न स्मराम्यप्रियं वाक्यं लोकस्य प्रियवादिनः / स कथं त्वत्कृते रामं वक्ष्यामि प्रियमप्रियम्","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/3361.jpg"},
  {"ocr_line":3386,"section":"2.10.39+2","text":"इति दुःखाभिसन्तप्तं प्रार्थयन्तं पुनः पुनः","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/3386.jpg"},
  {"ocr_line":3387,"section":"2.10.39+3","text":"प्रत्युवाचाथ कैकेयी रौद्रा रौद्रतरं वचः","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/3387.jpg"},
  {"ocr_line":3395,"section":"2.10.39+4","text":"भवत्वधर्मो धर्मो वा सत्यं वा यदि वाऽनृतम् / यत्त्वया संश्रुतं मह्यं तस्य नास्ति व्यतिक्रमः","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/3395.jpg"},
  {"ocr_line":3408,"section":"2.10.39+5","text":"यथा नान्येन तुष्येयमृते रामविवासनात्","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/3408.jpg"},
  {"ocr_line":3417,"section":"2.10.39+6","text":"एतावदुक्त्वा वचनं कैकेयी विरराम ह / दीनया तु गिरा राजा इति होवाच कैकयीम्","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/3417.jpg"},
  {"ocr_line":3433,"section":"2.10.39+7","text":"रामादपि हि तं मन्ये धर्मतो बलवत्तरम्","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/3433.jpg"},
  {"ocr_line":3440,"section":"2.10.39+8","text":"यदा यदा हि कौसल्या दासीवच्च सखीव च / भार्यावद्भगिनीवच्च मातृवच्चोपतिष्ठति","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/3440.jpg"},
  {"ocr_line":3460,"section":"2.10.39+10","text":"तं तु मां जीवलोकोऽयं नूनमाक्रोष्टुमर्हति","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/3460.jpg"},
  {"ocr_line":3478,"section":"2.10.39+11","text":"यदि मे राघवः कुर्याद्वनं गच्छेति चोदितः","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/3478.jpg"},
  {"ocr_line":3499,"section":"2.10.39+13","text":"प्रियं चेद्भरतस्यैतद्रामप्रव्राजनं भवेत्","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/3499.jpg"},
  {"ocr_line":3521,"section":"2.10.39+14","text":"लभतामसितापाङ्गे यशः परमवाप्नुहि","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/3521.jpg"},
  {"ocr_line":3533,"section":"2.10.39+15","text":"प्रियमेतद्गुरुश्रोणि कुरु चारुमुखेक्षणे","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/3533.jpg"},
  {"ocr_line":3573,"section":"2.12.3+1","text":"धर्मस्यैवाभिकामार्थं मम चैवाभिचोदनात्","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/3573.jpg"},
  {"ocr_line":3625,"section":"2.12.8+1","text":"वेदास्सहाङ्गविद्याश्च यथा ह्यात्मभुवं विभुम् / ब्रह्माणं बोधयन्त्यद्य तथा त्वां बोधयाम्यहम्","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/3625.jpg"},
  {"ocr_line":3667,"section":"2.14.11+1","text":"अथ सीतामनुज्ञाप्य कृतकौतुकमङ्गलः","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/3667.jpg"},
  {"ocr_line":3730,"section":"2.16.17+1","text":"एवमुक्ता तु कैकेयी राघवेण महात्मना / उवाचेदं सुनिर्लज्जा धृष्टमात्महितं वचः","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/3730.jpg"},
  {"ocr_line":3739,"section":"2.16.17+2","text":"न राजा कुपितो राम व्यसनं नास्य किञ्चन / प्रियं त्वामप्रियं वक्तुं वाणी नास्योपवर्तते","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/3739.jpg"},
  {"ocr_line":3743,"section":"2.16.17+3","text":"तदवश्यं त्वया कार्यं यदनेनाश्रुतं मम","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/3743.jpg"},
  {"ocr_line":3752,"section":"2.16.17+4","text":"यदि त्वभिहितं राज्ञा त्वयि तन्न विपत्स्यते","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/3752.jpg"},
  {"ocr_line":3760,"section":"2.16.17+5","text":"एतत्तु वचनं श्रुत्वा कैकेय्या समुदाहृतम् / उवाच व्यथितो रामस्तां देवीं नृपसन्निधौ","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/3760.jpg"},
  {"ocr_line":3995,"section":"2.16.58+1","text":"वाचा मधुरया रामः सर्वं संमानयञ्जनम् / मातुस्समीपं धीरात्मा प्रविवेश महायशाः","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/3995.jpg"},
  {"ocr_line":4007,"section":"2.16.58+2","text":"परिष्वक्तश्च बाहुभ्यामुपाघ्रातश्च मूर्धनि","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/4007.jpg"},
  {"ocr_line":4187,"section":"2.18.6+1","text":"गुरोरप्यवलिप्तस्य कार्याकार्यमजानतः / उत्पथं प्रतिपन्नस्य कार्यं भवति शासनम्","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/4187.jpg"},
  {"ocr_line":4296,"section":"2.18.32+1","text":"वाक्यं वाक्यविदां श्रेष्ठः श्रेष्ठस्सर्वधनुष्मताम्","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/4296.jpg"},
  {"ocr_line":4409,"section":"2.19.20+2","text":"मा च लक्ष्मण सन्तापं कार्षीर्लक्ष्म्या विपर्यये / राज्यं वा वनवासो वा वनवासो महोदयः","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/4409.jpg"},
  {"ocr_line":4522,"section":"2.21.20+1","text":"भर्तुः शुश्रूषया नारी लभते स्वर्गमुत्तमम् / अपि या निर्नमस्कारा निवृत्ता देवपूजनात्","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/4522.jpg"},
  {"ocr_line":4570,"section":"2.21.22+1","text":"गमने सुकृतां बुद्धिं न ते शक्नोमि पुत्रक / विनिवर्तयितुं वीर नूनं कालो दुरत्ययः","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/4570.jpg"},
  {"ocr_line":4582,"section":"2.21.22+2","text":"गच्छेदानीं महाबाहो क्षेमेण पुनरागतः / नन्दयिष्यसि मां पुत्र साम्ना वाक्येन चारुणा","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/4582.jpg"},
  {"ocr_line":4679,"section":"2.22.14+1","text":"त्रीन्विक्रमान् प्रक्रमतो विष्णोरमिततेजसः / यदासीन्मङ्गलं राम तत्ते भवतु मङ्गलम्","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/4679.jpg"},
  {"ocr_line":4703,"section":"2.22.14+2","text":"मङ्गलैरुपसंपन्नो वनवासादिहागतः","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/4703.jpg"},
  {"ocr_line":4863,"section":"2.23.29+1","text":"भरतस्य रता धर्मे सत्यव्रतपरायणा","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/4863.jpg"},
  {"ocr_line":4972,"section":"2.25.4+1","text":"यताहारैर्वनचरैर्नित्यं दुःखमतो वनम्","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/4972.jpg"},
  {"ocr_line":5120,"section":"2.27.30+1","text":"आरभस्व गुरुश्रोणि वनवासक्षमाः क्रियाः / नेदानीं त्वदृते सीते स्वर्गोऽपि मम रोचते","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/5120.jpg"},
  {"ocr_line":5148,"section":"2.27.32+1","text":"स भ्रातुश्चरणौ गाढं निपीड्य रघुनन्दनः / सीतामुवाचातियशां राघवं च महाव्रतम्","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/5148.jpg"},
  {"ocr_line":5169,"section":"2.27.32+3","text":"न देवलोकाक्रमणं नामरत्वमहं वृणे","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/5169.jpg"},
  {"ocr_line":5188,"section":"2.28.1+1","text":"स्निग्धो धर्मरतो वीरः सततं सत्पथे स्थितः / प्रियः प्राणसमो वश्यो भ्राता चापि सखा च मे","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/5188.jpg"},
  {"ocr_line":5203,"section":"2.28.2+1","text":"न स्मरिष्यति कौसल्यां सुमित्रां च सुदुःखिताम् / भरतो राज्यमासाद्य कैकेय्यां पर्यवस्थितः","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/5203.jpg"},
  {"ocr_line":5222,"section":"2.28.2+2","text":"धर्मज्ञ गुरुपूजायां धर्मश्चाप्यतुलो महान्","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/5222.jpg"},
  {"ocr_line":5230,"section":"2.28.2+3","text":"एवं कुरुष्व सौमित्रे मत्कृते रघुनन्दन / अस्माभिर्विप्रहीणाया मातुर्नो न भवेत् सुखम्","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/5230.jpg"},
  {"ocr_line":5314,"section":"2.30.1+1","text":"उवाच रामस्तं सूतं पितुराख्याहि मामिति","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/5314.jpg"},
  {"ocr_line":5457,"section":"2.31.25+1","text":"पुनः पादौ ग्रहीष्यामि प्रतिज्ञान्ते नराधिप","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/5457.jpg"},
  {"ocr_line":5602,"section":"2.35.8+1","text":"वनवासं हि संख्याय वासांस्याभरणानि च / भर्तारमनुगच्छन्त्यै सीतायै श्वशुरो ददौ","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/5602.jpg"},
  {"ocr_line":5668,"section":"2.43.2+1","text":"समुद्रमहिषीं गङ्गां सारसक्रौञ्चनादिताम्","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/5668.jpg"},
  {"ocr_line":5838,"section":"2.52.12+1","text":"अप्रमादं च वक्तव्या ब्रूयाश्चैनामिदं वचः","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/5838.jpg"},
  {"ocr_line":5845,"section":"2.52.12+2","text":"धर्मनित्या यथाकालमग्न्यगारपरा भव","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/5845.jpg"},
  {"ocr_line":5934,"section":"2.53.24+1","text":"इति रामस्य मातुश्च सुमित्रायाश्च सन्निधौ","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/5934.jpg"},
  {"ocr_line":5982,"section":"2.61.3+1","text":"राजा सत्यं च धर्मश्च राजा कुलवतां कुलम्","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/5982.jpg"},
  {"ocr_line":6086,"section":"2.66.2+1","text":"उवाच वचनं हृष्टा मूढा पण्डितमानिनी","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/6086.jpg"},
  {"ocr_line":6141,"section":"2.66.44+1","text":"त्वदधीना हि नगरी राज्यं चैतदनामयम्","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/6141.jpg"},
  {"ocr_line":6174,"section":"2.67.4+1","text":"विनाशितो महाराजः पिता मे धर्मवत्सलः","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/6174.jpg"},
  {"ocr_line":6258,"section":"2.67.14+1","text":"न मे विकाङ्क्षा जायेत त्यक्तुं त्वां पापनिश्चयाम् / यदि रामस्य नापेक्षा त्वयि स्यान्मातृवत् सदा","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/6258.jpg"},
  {"ocr_line":6551,"section":"2.91.2+1","text":"पितुस्सत्यं प्रतिश्रुत्य हत्वा भरतमागतम्","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/6551.jpg"},
  {"ocr_line":6580,"section":"2.91.2+3","text":"इच्छामि भवतामर्थे एतत् प्रतिशृणोमि ते","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/6580.jpg"},
  {"ocr_line":6589,"section":"2.91.2+4","text":"राज्यमप्यहमिच्छामि सत्येनायुधमालभे","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/6589.jpg"},
  {"ocr_line":6625,"section":"2.91.2+6","text":"श्रुत्वा प्रव्राजितं मां हि जटावल्कलधारिणम् / जानक्या सहितं वीर त्वया च पुरुषर्षभ / स्नेहेनाक्रान्तहृदयः शोकेनाकुलितेन्द्रियः","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/6625.jpg"},
  {"ocr_line":6651,"section":"2.91.2+7","text":"अम्बां च कैकयीं रुष्य परुषं चाप्रियं वदन् / प्रसाद्य पितरं श्रीमान् राज्यं मे दातुमागतः","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/6651.jpg"},
  {"ocr_line":6849,"section":"2.95.3+1","text":"दुःखशोकाभिभूतस्तु राजा त्रिदिवमभ्यगात्","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/6849.jpg"},
  {"ocr_line":7539,"section":"2.104.22+1","text":"स पादुके संप्रणम्य रामं वचनमब्रवीत्","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/7539.jpg"},
  {"ocr_line":7589,"section":"2.104.22+4","text":"मया च सीतया चैव शप्तोऽसि रघुसत्तम","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/7589.jpg"},
  {"ocr_line":7628,"section":"2.107.22+1","text":"तदधीनस्तदा राज्यं कारयामास सर्वदा","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/7628.jpg"},
  {"ocr_line":7814,"section":"3.5.14+1","text":"परा त्वत्तो गतिर्वीर पृथिव्यां नोपपद्यते","by":"agreed","crop":"data/sources/ocr/ramayana-condensed-crops/7814.jpg"}
